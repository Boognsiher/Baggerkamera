#pragma once

// Copy this file to "secrets.h" (same folder) and fill in your values.
// secrets.h is gitignored so your WiFi password never gets committed.

// WIFI_MODE choices:
//   WIFI_MODE_AP_ONLY   - ESP32 opens its own hotspot. The phone connects
//                          directly to it. Works anywhere, no router needed
//                          (best when the excavator is out in the garden,
//                          far from your home WiFi).
//   WIFI_MODE_STA_ONLY  - ESP32 joins your home WiFi. Phone must be on the
//                          same network. Longer range than the ESP32's own
//                          weak hotspot antenna if your router covers the area.
//   WIFI_MODE_STA_WITH_AP_FALLBACK - tries to join your home WiFi first,
//                          and automatically falls back to its own hotspot
//                          if that fails (e.g. out of router range). Recommended.
#define WIFI_MODE_AP_ONLY               0
#define WIFI_MODE_STA_ONLY              1
#define WIFI_MODE_STA_WITH_AP_FALLBACK  2

#define WIFI_MODE WIFI_MODE_STA_WITH_AP_FALLBACK

// Your home WiFi (only used in STA_ONLY / STA_WITH_AP_FALLBACK).
#define WIFI_STA_SSID     "your-home-wifi"
#define WIFI_STA_PASSWORD "your-home-wifi-password"

// The hotspot the ESP32 itself creates (used in AP_ONLY, and as the
// fallback in STA_WITH_AP_FALLBACK). Password must be 8+ characters,
// or leave it "" for an open network.
#define WIFI_AP_SSID      "Baggerkamera"
#define WIFI_AP_PASSWORD  "bagger1234"

// Optional: reachable as http://baggerkamera.local/ when in STA mode
// (works well on iPhones; on Android use the IP address printed on
// Serial instead, mDNS support there is unreliable).
#define MDNS_HOSTNAME     "baggerkamera"
